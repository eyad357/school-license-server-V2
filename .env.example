# Copy to .env (never commit .env). Real values go in Railway Variables.
PORT=3100
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/school_license_dev
ADMIN_USERNAME=admin
# bcrypt hash, generate with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" "your-password"
ADMIN_PASSWORD_HASH=
# long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional (default 100 requests/minute/IP on /api/)
# API_RATE_LIMIT_MAX=100

# Payments (only if the Paddle checkout is enabled)
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_PRICE_ID=
# PADDLE_API_BASE_URL=https://api.paddle.com
